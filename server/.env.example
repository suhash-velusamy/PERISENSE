# Copy this file to .env and fill in real values. Never commit .env itself.

# Secret used to sign/verify JWTs. Use a long random string.
JWT_SECRET=

# MongoDB Atlas (or other) connection string.
MONGODB_URI=

# Server port (optional, defaults to 5000)
PORT=5000

# Pusher (server-side app credentials — from the Pusher dashboard)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# OpenRouteService (server-side only, Stage 12 routing service). Get a free
# key at openrouteservice.org/dev — never expose this one to the mobile app.
ORS_API_KEY=
